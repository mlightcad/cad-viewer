{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "allowJs": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@mlightcad/cad-simple-ui-plugin/toolbar": [
        "./packages/cad-simple-ui-plugin/src/toolbar.ts"
      ],
      "@mlightcad/cad-simple-ui-plugin/setup-toolbar": [
        "./packages/cad-simple-ui-plugin/src/setupToolbar.ts"
      ],
      "@mlightcad/cad-simple-viewer/icons": [
        "./packages/cad-simple-viewer/src/ui/icons.ts"
      ]
    }
  },
  "include": [
    "jest.config.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ]
}
