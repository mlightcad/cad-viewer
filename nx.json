{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
        "default",
        { "env": "VITE_MSAL_CLIENT_ID" },
        { "env": "VITE_MSAL_TENANT_ID" },
        { "env": "VITE_MSAL_REDIRECT_URI" }
      ],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/lib"
      ]
    },
    "dev": {
      "dependsOn": [
        {
          "target": "build",
          "dependencies": true
        }
      ]
    }
  }
}
