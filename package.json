{
  "name": "mlightcad",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "author": "MLight Lee <mlight.lee@outlook.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlightcad/cad-viewer"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "analyze": "nx run-many -t analyze",
    "build": "nx run-many -t build",
    "clean": "nx run-many -t clean",
    "copy:workers": "pnpm -r --filter \"./packages/**\" run copy:workers",
    "dev": "nx run @mlightcad/cad-viewer-example:dev",
    "dev:simple": "nx run @mlightcad/cad-simple-viewer-example:dev",
    "dev:diff": "nx run @mlightcad/cad-diff-viewer-example:dev",
    "docs:api": "typedoc --skipErrorChecking",
    "docs:build": "vitepress build docs",
    "docs:all": "pnpm docs:build && pnpm docs:api",
    "docs:site": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "cli": "nx run @mlightcad/cad-simple-viewer-cli:build && node packages/cad-simple-viewer-cli/dist/cli.js",
    "cli:run": "node packages/cad-simple-viewer-cli/dist/cli.js",
    "cli:setup": "pnpm --filter @mlightcad/cad-simple-viewer-cli install-browser",
    "cli:examples": "pnpm --filter @mlightcad/cad-simple-viewer-cli build && pnpm --filter @mlightcad/cad-simple-viewer-cli examples",
    "export:html": "nx run @mlightcad/cad-simple-viewer-cli:build && node packages/cad-simple-viewer-cli/dist/cli.js -i packages/cad-viewer-example/e2e/fixtures/minimal-line.dxf -s packages/cad-simple-viewer-cli/examples/export-html.scr -o tmp --mode read",
    "format": "prettier --config ./.prettierrc.js --write \"packages/**/*.{ts,js,vue,json}\"",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "preview": "nx run @mlightcad/cad-viewer-example:preview",
    "preview:simple": "nx run @mlightcad/cad-simple-viewer-example:preview",
    "preview:diff": "nx run @mlightcad/cad-diff-viewer-example:preview",
    "pre-serve": "nx run @mlightcad/cad-viewer-examples:pre-serve",
    "publish:viewer": "pnpm -r publish --access public --no-git-checks",
    "release": "node tools/release.mjs",
    "sync:versions": "node tools/sync-versions.mjs",
    "sync:versions:check": "node tools/sync-versions.mjs --check",
    "serve": "nx run @mlightcad/cad-viewer-examples:serve",
    "test": "jest",
    "test:e2e": "pnpm --filter @mlightcad/cad-viewer-example test:e2e",
    "use:dwg-converter": "node tools/use-dwg-converter.mjs"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.9.1",
    "@intlify/eslint-plugin-vue-i18n": "^3.0.0",
    "@nx/js": "20.0.4",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@types/rollup-plugin-peer-deps-external": "^2.2.5",
    "@typescript-eslint/parser": "^8.4.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^9.28.0",
    "globals": "^15.9.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^15.2.7",
    "nx": "20.0.4",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-visualizer": "^5.12.0",
    "ts-jest": "^29.1.5",
    "typedoc": "^0.28.18",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.4.0",
    "vite": "^6.4.3",
    "vite-plugin-static-copy": "^4.1.1",
    "vitepress": "^1.6.4"
  },
  "lint-staged": {
    "*.{ts,js,vue}": [
      "prettier --config ./.prettierrc.js --write",
      "eslint --config ./.eslintrc.js --fix --quiet"
    ],
    "*.md": [
      "prettier --config ./.prettierrc.js --write"
    ]
  }
}
