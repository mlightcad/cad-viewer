{
  "name": "@mlightcad/cad-agent-core",
  "version": "1.8.0-preview.1",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlightcad/cad-viewer.git"
  },
  "files": [
    "dist",
    "lib",
    "README.md",
    "package.json"
  ],
  "main": "./dist/cad-agent-core.umd.cjs",
  "module": "./dist/cad-agent-core.js",
  "types": "./lib/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./dist/cad-agent-core.js",
      "require": "./dist/cad-agent-core.umd.cjs"
    },
    "./script-api": {
      "types": "./lib/script-api.d.ts",
      "import": "./dist/cad-agent-core-script-api.js",
      "require": "./dist/cad-agent-core-script-api.umd.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist lib tsconfig.tsbuildinfo",
    "build": "tsc && vite build && vite build --config vite.script-api.config.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix --quiet src/"
  },
  "devDependencies": {
    "@mlightcad/cad-html-plugin": "workspace:*",
    "@mlightcad/cad-pdf-core": "workspace:*",
    "@mlightcad/cad-script-core": "workspace:*",
    "@mlightcad/cad-simple-viewer": "workspace:*",
    "@mlightcad/data-model": "1.15.22",
    "@mlightcad/mtext-parser": "1.5.7",
    "@mlightcad/pdf-renderer": "workspace:*",
    "@mlightcad/three-renderer": "workspace:*"
  },
  "peerDependencies": {
    "@mlightcad/cad-html-plugin": "workspace:^",
    "@mlightcad/cad-pdf-core": "workspace:^",
    "@mlightcad/cad-script-core": "workspace:^",
    "@mlightcad/cad-simple-viewer": "workspace:^",
    "@mlightcad/data-model": "1.15.22",
    "@mlightcad/mtext-parser": "1.5.7",
    "@mlightcad/pdf-renderer": "workspace:^",
    "@mlightcad/three-renderer": "workspace:^"
  }
}
