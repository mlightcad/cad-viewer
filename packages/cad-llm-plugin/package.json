{
  "name": "@mlightcad/cad-llm-plugin",
  "version": "1.8.0-preview.3",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlightcad/cad-viewer.git"
  },
  "files": [
    "dist",
    "lib",
    "README.md",
    "package.json"
  ],
  "main": "./dist/cad-llm-plugin.umd.cjs",
  "module": "./dist/cad-llm-plugin.js",
  "sideEffects": false,
  "types": "./lib/index.d.ts",
  "typesVersions": {
    "*": {
      "register": [
        "lib/register.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./dist/cad-llm-plugin.js",
      "require": "./dist/cad-llm-plugin.umd.cjs"
    },
    "./register": {
      "types": "./lib/register.d.ts",
      "import": "./dist/cad-llm-plugin-register.js",
      "require": "./dist/cad-llm-plugin-register.umd.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist lib tsconfig.tsbuildinfo",
    "build": "tsc && vite build",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix --quiet src/"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "ai": "^5.0.0"
  },
  "devDependencies": {
    "@mlightcad/cad-simple-viewer": "workspace:*",
    "vite": "^6.4.3"
  },
  "peerDependencies": {
    "@mlightcad/cad-simple-viewer": "workspace:^"
  }
}
