    }
  },
  "scripts": {
    "clean": "rimraf dist lib tsconfig.tsbuildinfo",
    "build": "tsc && vite build",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix --quiet src/"
  },
  "devDependencies": {
    "@mlightcad/data-model": "1.15.26",
    "@types/svg-parser": "2.0.6"
  },
  "peerDependencies": {
    "@mlightcad/data-model": "1.15.26"
  },
  "dependencies": {
    "svg-parser": "2.1.0"
  }
