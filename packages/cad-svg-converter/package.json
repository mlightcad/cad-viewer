  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlightcad/cad-viewer.git"
  },
  "files": [
    "dist",
    "lib",
    "README.md",
    "package.json"
  ],
  "main": "./dist/cad-svg-converter.umd.cjs",
  "module": "./dist/cad-svg-converter.js",
