{
  "name": "@mlightcad/cad-simple-viewer",
  "version": "1.8.0-preview.3",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlightcad/cad-viewer.git"
  },
  "keywords": [
    "autocad",
    "cad",
    "cad-viewer",
    "dwg",
    "dwg-viewer",
    "dxf",
    "dxf-viewer",
    "mlight",
    "mlightcad"
  ],
  "files": [
    "dist",
    "lib",
    "icons.ts",
    "find.ts",
    "file-open-panel.ts",
    "simple-ui.ts",
    "src/ui/icons.ts",
    "src/find",
    "src/simple-ui",
    "src/file-open-panel.ts",
    "README.md",
    "package.json"
  ],
  "main": "./dist/cad-simple-viewer.umd.cjs",
  "module": "./dist/cad-simple-viewer.js",
  "types": "./lib/index.d.ts",
  "sideEffects": [
    "**/simple-ui/ui/styles.ts",
    "**/command/markup/AcApMarkupSessionBootstrap.ts"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./dist/cad-simple-viewer.js",
      "require": "./dist/cad-simple-viewer.umd.cjs"
    },
    "./file-open-panel": {
      "types": "./lib/file-open-panel.d.ts",
      "import": {
        "development": "./src/file-open-panel.ts",
        "default": "./dist/cad-simple-viewer-file-open-panel.js"
      },
      "default": "./dist/cad-simple-viewer-file-open-panel.js"
    },
    "./icons": {
      "types": "./src/ui/icons.ts",
      "import": "./src/ui/icons.ts",
      "default": "./lib/ui/icons.js"
    },
    "./find": {
      "types": "./src/find/index.ts",
      "import": "./src/find/index.ts",
      "default": "./lib/find/index.js"
    },
    "./simple-ui": {
      "development": {
        "types": "./lib/simple-ui/index.d.ts",
        "import": "./src/simple-ui/index.ts",
        "default": "./src/simple-ui/index.ts"
      },
      "types": "./lib/simple-ui/index.d.ts",
      "import": "./dist/cad-simple-viewer-simple-ui.js",
      "default": "./dist/cad-simple-viewer-simple-ui.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist lib tsconfig.tsbuildinfo",
    "build": "tsc && vite build",
    "copy:workers": "node ../../tools/copy-workers.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix --quiet src/"
  },
  "devDependencies": {
    "@mlightcad/data-model": "1.15.26",
    "@mlightcad/mtext-input-box": "0.3.9",
    "@mlightcad/mtext-parser": "1.5.7",
    "@mlightcad/mtext-renderer": "0.13.9",
    "@mlightcad/three-renderer": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "@types/rbush": "^3.0.4",
    "@types/three": "^0.186.0",
    "lodash-es": "4.17.21",
    "mitt": "^3.0.1",
    "rbush": "^4.0.1",
    "three": "^0.186.1"
  },
  "peerDependencies": {
    "@mlightcad/data-model": "1.15.26",
    "@mlightcad/mtext-parser": "1.5.7",
    "@mlightcad/mtext-renderer": "0.13.9",
    "@mlightcad/three-renderer": "workspace:^",
    "lodash-es": "4.17.21",
    "three": "^0.186.1"
  }
}
