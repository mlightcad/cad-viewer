{
  "name": "@mlightcad/cad-mcp-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/cad-mcp-server/src",
  "projectType": "application",
  "tags": ["npm:public"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc && vite build --config vite.runner.config.ts && node scripts/copy-runner-assets.mjs",
        "cwd": "packages/cad-mcp-server"
      },
      "dependsOn": ["^build"],
      "cache": true
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf dist dist-runner tsconfig.tsbuildinfo",
        "cwd": "packages/cad-mcp-server"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src/",
        "cwd": "packages/cad-mcp-server"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --fix --quiet src/",
        "cwd": "packages/cad-mcp-server"
      }
    }
  }
}
