{
  "name": "@mlightcad/cad-mcp-server",
  "version": "1.7.8-preview.0",
  "description": "stdio MCP server for CAD drawings: open_drawing + execute_cad_script (cad-agent-core)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cad-mcp-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "dist-runner",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mlightcad/cad-viewer.git",
    "directory": "packages/cad-mcp-server"
  },
  "homepage": "https://github.com/mlightcad/cad-viewer/tree/main/packages/cad-mcp-server",
  "bugs": {
    "url": "https://github.com/mlightcad/cad-viewer/issues"
  },
  "keywords": [
    "autocad",
    "cad",
    "cad-viewer",
    "mcp",
    "model-context-protocol",
    "mlight",
    "mlightcad"
  ],
  "scripts": {
    "build": "tsc && vite build --config vite.runner.config.ts && node scripts/copy-runner-assets.mjs",
    "install-browser": "playwright install chromium",
    "smoke": "node ./scripts/smoke.mjs",
    "clean": "rimraf dist dist-runner tsconfig.tsbuildinfo",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix --quiet src/"
  },
  "dependencies": {
    "@mlightcad/cad-agent-core": "workspace:*",
    "@mlightcad/cad-simple-viewer": "workspace:*",
    "@mlightcad/data-model": "1.15.14",
    "@mlightcad/libredwg-converter": "3.15.14",
    "@mlightcad/mtext-renderer": "0.13.6",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "playwright": "^1.49.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.2",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
