# Azure AD / Entra ID SPA application client ID (required for OneDrive).
VITE_MSAL_CLIENT_ID=your_msal_client_id_here

# common = work + personal Microsoft accounts
VITE_MSAL_TENANT_ID=common

# Must match an SPA redirect URI registered in Azure for this client.
# Default Vite dev server: http://localhost:5173/
# If omitted, the OneDrive plugin uses the current page origin.
VITE_MSAL_REDIRECT_URI=http://localhost:5173/

# Google Drive (optional) — OAuth Web client, API key, and numeric project number.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_API_KEY=your_google_api_key_here
VITE_GOOGLE_APP_ID=your_google_app_id_here
