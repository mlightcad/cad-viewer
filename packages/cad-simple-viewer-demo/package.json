{
  "name": "@mlightcad/cad-simple-viewer-demo",
  "private": true,
  "version": "1.7.8-preview.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlightcad/cad-viewer.git"
  },
  "scripts": {
    "build": "tsc && vite build",
    "clean": "rimraf dist lib tsconfig.tsbuildinfo",
    "copy:workers": "node ../../tools/copy-workers.mjs dist/workers",
    "dev": "vite",
    "dev:html-converter": "vite --open /html-converter.html",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix --quiet src/",
    "preview": "vite preview",
    "preview:html-converter": "vite preview --open /html-converter.html"
  },
  "dependencies": {
    "@mlightcad/cad-agent-core": "workspace:*",
    "@mlightcad/cad-agent-plugin": "workspace:*",
    "@mlightcad/cad-script-plugin": "workspace:*",
    "@mlightcad/cad-html-plugin": "workspace:*",
    "@mlightcad/cad-onedrive-plugin": "workspace:*",
    "@mlightcad/cad-google-drive-plugin": "workspace:*",
    "@mlightcad/cad-pdf-plugin": "workspace:*",
    "@mlightcad/pdf-renderer": "workspace:*",
    "@mlightcad/cad-simple-ui-plugin": "workspace:*",
    "@mlightcad/cad-svg-plugin": "workspace:*",
    "@mlightcad/cad-simple-viewer": "workspace:*",
    "@mlightcad/data-model": "1.15.18",
    "@mlightcad/libredwg-converter": "3.15.18",
    "@mlightcad/mtext-parser": "1.5.5",
    "@mlightcad/mtext-renderer": "0.13.6",
    "@mlightcad/three-renderer": "workspace:*",
    "lodash-es": "4.17.21",
    "three": "^0.186.1",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^6.4.3",
    "vite-plugin-static-copy": "^4.1.1"
  }
