{
  "name": "@mlightcad/cad-pdf-exporter",
  "version": "1.8.0-preview.1",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlightcad/cad-viewer.git"
  },
  "files": [
    "dist",
    "lib",
    "examples",
    "README.md",
    "package.json"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./lib/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist lib tsconfig.tsbuildinfo",
    "build": "tsc && vite build",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix --quiet src/"
  },
  "dependencies": {
    "@mlightcad/cad-pdf-core": "workspace:*",
    "@mlightcad/data-model": "1.15.22",
    "@mlightcad/libredwg-converter": "3.15.22",
    "@mlightcad/libredwg-web": "0.8.2",
    "@mlightcad/mtext-parser": "1.5.7",
    "@mlightcad/mtext-renderer": "0.13.7",
    "@mlightcad/pdf-renderer": "workspace:*",
    "@mlightcad/three-renderer": "workspace:*",
    "three": "^0.186.1",
    "web-worker": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0"
  },
  "engines": {
    "node": ">=22"
  }
}
